<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VCEPUWasteFix</AssemblyName>
    <RootNamespace>VCEPUWasteFix</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <NoWarn>NU1701;CS0618;CS8981</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Override with: dotnet build -p:RimWorldDir="C:\path\to\RimWorld" -->
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">E:\steam\steamapps\common\RimWorld</RimWorldDir>
    <HarmonyDir Condition="'$(HarmonyDir)' == ''">E:\steam\steamapps\workshop\content\294100\2009463077\1.7\Assemblies</HarmonyDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Source\VCEPUWasteFix.cs" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
